{%- assign return_delivery_first = return.deliveries | first -%}
{%- assign public_file_url = return_delivery_first.return_label.public_file_url -%}
{%- assign has_label_attached = false -%}
{%- if public_file_url != blank and public_file_url.size > 0 -%}
  {%- assign has_label_attached = true -%}
{%- endif -%}
{%- assign has_tracking_number = return_delivery_first.tracking_number -%}
{% if order.customer_order_url %}
  {%- assign order_details_url = order.customer_order_url -%}
{% else %}
  {%- assign order_details_url = order.order_status_url -%}
{% endif %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{ email_title }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <style>
      .button { background: {{ shop.email_accent_color }}; }
      a, a:hover, a:active, a:visited { color: {{ shop.email_accent_color }}; }
    </style>
  </head>
  <body>
    {%- if shop.email_logo_url %}
      <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}">
    {%- else %}
      <h1>
        <a href="{{ shop.url }}">{{ shop.name }}</a>
      </h1>
    {%- endif %}

    <h2>Your return request was approved</h2>

    <p>
      {% if return_delivery_first %}
        {% if has_label_attached %}
          Print your return shipping label and attach it to the package containing your return items.
        {% elsif return_delivery_first.type == 'shopify_label' and return.order_total_outstanding > 0 %}
          Your return request was approved and you have an outstanding balance. Pay the outstanding balance, and once you receive your return shipping label, follow the instructions to complete your return.
        {% else %}
          We've sent you a return shipping label, or you will receive one soon. Once you receive your return shipping label, follow the instructions to complete your return.
        {% endif %}
      {% else %}
        We'll send you additional information to complete your return.
      {% endif %}
    </p>

    {% if has_label_attached or has_tracking_number %}
      <h3>Instructions</h3>
      <ol>
        <li>Pack the items you're returning.</li>
        {% if return.checkout_payment_collection_url %}
          <li>Pay the outstanding balance.</li>
        {% endif %}
        <li>Print your return label and attach it to the package. Cover or remove any old shipping labels.</li>
        <li>
          {% if return_delivery_first.carrier_name %}
            Give the package to {{ return_delivery_first.carrier_name }}.
          {% else %}
            Give the package to the carrier identified on the label.
          {% endif %}
        </li>
        {% if has_tracking_number %}
          <li>Track your return to make sure we get it.</li>
        {% endif %}
      </ol>

      {% if has_tracking_number %}
        <p>
          {% if return_delivery_first.carrier_name %}
            {{ return_delivery_first.carrier_name }} tracking number: <a target="_blank" href="{{ return_delivery_first.tracking_url }}">{{ return_delivery_first.tracking_number }}</a>
          {% else %}
            Tracking number: <a target="_blank" href="{{ return_delivery_first.tracking_url }}">{{ return_delivery_first.tracking_number }}</a>
          {% endif %}
        </p>
      {% endif %}
    {% endif %}

    {% if has_label_attached %}
      {% if public_file_url != blank %}
        <a href="{{ public_file_url }}">Print return label</a>
      {% endif %}
      {% if return.checkout_payment_collection_url != blank %}
        <a href="{{ return.checkout_payment_collection_url }}">Pay now</a>
      {% endif %}
      or <a href="{{ order_details_url }}">View your order</a>
    {% else %}
      {% if return.checkout_payment_collection_url != blank %}
        <a href="{{ return.checkout_payment_collection_url }}">Pay now</a>
        or <a href="{{ order_details_url }}">View your order</a>
      {% else %}
        <a href="{{ order_details_url }}">View your order</a>
      {% endif %}
    {% endif %}

    {% if return.line_items.size > 0 %}
      <h3>Items to return</h3>

      {% for line_item in return.line_items %}
        {% if line_item.image %}
          <img src="{{ line_item | img_url: 'compact_cropped' }}" align="left" width="60" height="60" />
        {% endif %}

        {% assign line_display = line_item.quantity %}

        {{ line_item.title }} × {{ line_display }}

        {% if line_item.variant_title != 'Default Title' %}
          {{ line_item.variant_title }}
        {% endif %}

        {% if line_item.discount_allocations %}
          {% for discount_allocation in line_item.discount_allocations %}
            <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" />
            {{ discount_allocation.discount_application.title | upcase }}
            (-{{ discount_allocation.amount | money }})
          {% endfor %}
        {% endif %}

        {% if line_item.original_line_price != line_item.final_line_price %}
          <del>{{ line_item.original_line_price | money }}</del>
        {% endif %}

        <p>
          {% if line_item.final_line_price > 0 %}
            {{ line_item.final_line_price | money }}
          {% else %}
            Free
          {% endif %}
        </p>
      {% endfor %}
    {% endif %}

    {% if return.exchange_line_items.size > 0 %}
      <h3>Items you'll receive</h3>

      {% for line_item in return.exchange_line_items %}
        {% if line_item.image %}
          <img src="{{ line_item | img_url: 'compact_cropped' }}" align="left" width="60" height="60" />
        {% endif %}

        {% assign line_display = line_item.quantity %}

        {{ line_item.title }} × {{ line_display }}

        {% if line_item.variant_title != 'Default Title' %}
          {{ line_item.variant_title }}
        {% endif %}

        {% if line_item.discount_allocations %}
          {% for discount_allocation in line_item.discount_allocations %}
            <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" />
            {{ discount_allocation.discount_application.title | upcase }}
            (-{{ discount_allocation.amount | money }})
          {% endfor %}
        {% endif %}

        {% if line_item.original_line_price != line_item.final_line_price %}
          <del>{{ line_item.original_line_price | money }}</del>
        {% endif %}

        <p>
          {% if line_item.final_line_price > 0 %}
            {{ line_item.final_line_price | money }}
          {% else %}
            Free
          {% endif %}
        </p>
      {% endfor %}
    {% endif %}

    {% capture line_items_subtotal_price %}
      {% if return.line_items_subtotal_price < 0 %}
        -{{ return.line_items_subtotal_price | abs | money }}
      {% else %}
        {{ return.line_items_subtotal_price | money }}
      {% endif %}
    {% endcapture %}

    <p>Subtotal</p>
    <p><strong>{{ line_items_subtotal_price }}</strong></p>

    {% for fee in return.fees %}
      <p>{{ fee.title }}</p>
      <p><strong>{{ fee.subtotal | money }}</strong></p>
    {% endfor %}

    {% if return.total_tax_price %}
      {% capture total_tax_price %}
        {% if return.total_tax_price < 0 %}
          -{{ return.total_tax_price | abs | money }}
        {% else %}
          {{ return.total_tax_price | money }}
        {% endif %}
      {% endcapture %}

      <p>Estimated taxes</p>
      <p><strong>{{ total_tax_price }}</strong></p>
    {% endif %}

    {% if return.pre_return_order_total_outstanding and return.pre_return_order_total_outstanding != 0 %}
      <p>Outstanding balance</p>
      <p><strong>{{ return.pre_return_order_total_outstanding | money_with_currency }}</strong></p>
    {% endif %}

    {% if return.order_total_outstanding > 0 %}
      <p>Amount to pay</p>
      <p><strong>{{ return.order_total_outstanding | money_with_currency }}</strong></p>
    {% elsif return.order_total_outstanding <= 0 %}
      <p>Estimated refund</p>
      <p><strong>{{ return.order_total_outstanding | abs | money_with_currency }}</strong></p>
    {% endif %}

    <p>If you have any questions, reply to this email or contact us at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
  </body>
</html>
