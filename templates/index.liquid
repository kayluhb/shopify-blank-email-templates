  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background: #f6f6f7;
      color: #303030;
      margin: 0;
      padding: 40px 24px;
    }
    .wrap { max-width: 840px; margin: 0 auto; }
    h1 {
      font-size: 28px;
      font-weight: 600;
      color: #202223;
      margin: 0 0 8px;
    }
    .tagline {
      color: #008060;
      font-size: 13px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0 0 24px;
    }
    .intro {
      line-height: 1.6;
      margin-bottom: 32px;
      color: #616161;
      font-size: 15px;
    }
    h2 {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #6d7175;
      margin: 32px 0 12px;
      border-bottom: 1px solid #e1e3e5;
      padding-bottom: 8px;
    }
    ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 8px;
    }
    a {
      display: block;
      padding: 10px 14px;
      background: #fff;
      border: 1px solid #e1e3e5;
      border-radius: 4px;
      color: #202223;
      text-decoration: none;
      font-size: 14px;
      transition: border-color 0.15s, color 0.15s;
    }
    a:hover {
      border-color: #008060;
      color: #008060;
    }
    .count {
      font-size: 13px;
      color: #8c9196;
      margin-bottom: 8px;
    }
  </style>
</head>
